{
  "name": "@partygame/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json",
    "e2e": "playwright test",
    "deploy": "vite build && wrangler deploy",
    "deploy:staging": "cross-env CLOUDFLARE_ENV=staging vite build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@partygame/engine": "workspace:*",
    "@partygame/shared": "workspace:*",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.61.0",
    "@cloudflare/workers-types": "^5.20260927.1",
    "@playwright/test": "^1.63.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.0.0",
    "vite": "^8.3.1",
    "wrangler": "^4.142.0"
  }
}
